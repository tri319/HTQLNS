@model IEnumerable<HTQLNS.Controllers.ScheduleRowModel>
@{
    ViewData["Title"] = "Lịch & Phân ca";
    var daysOfWeek = new List<DayOfWeek> {
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, 
        DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday
    };
    var dayNames = new[] { "CN", "T2", "T3", "T4", "T5", "T6", "T7" };
    DateTime today = DateTime.Today;
    DateTime startOfWeek = ViewBag.StartOfWeek ?? today;
    int weekOffset = ViewBag.WeekOffset ?? 0;
    var scheduleList = ViewBag.ScheduleList as List<HTQLNS.Controllers.ScheduleListItem> ?? new List<HTQLNS.Controllers.ScheduleListItem>();
}

@if (TempData["Success"] != null)
{
    <div class="alert mb-4" style="background: rgba(27,185,154,.15); border:1px solid #1bb99a; color:#1bb99a; border-radius:8px; padding:12px 16px;">
        <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" asp-route-weekOffset="@(weekOffset - 1)" class="btn btn-dark" style="background-color: var(--card-bg); border-color: var(--border-color);"><i class="fa-solid fa-chevron-left"></i></a>
        <h5 class="mb-0 fw-bold px-2">@startOfWeek.ToString("dd/MM") - @startOfWeek.AddDays(6).ToString("dd/MM/yyyy")</h5>
        <a asp-action="Index" asp-route-weekOffset="@(weekOffset + 1)" class="btn btn-dark" style="background-color: var(--card-bg); border-color: var(--border-color);"><i class="fa-solid fa-chevron-right"></i></a>
        <a asp-action="Index" asp-route-weekOffset="0" class="btn ms-2" style="background-color: rgba(27, 185, 154, 0.15); color: var(--accent-green); border: none; border-radius: 8px;">Tuần này</a>
    </div>
    
    <div class="d-flex gap-3">
        <div class="btn-group" role="group">
            <button type="button" id="btnViewWeek" onclick="toggleScheduleView('week')" class="btn text-white px-4" style="background-color: var(--accent-purple); border: 1px solid var(--accent-purple); border-radius: 8px 0 0 8px;">Lịch tuần</button>
            <button type="button" id="btnViewList" onclick="toggleScheduleView('list')" class="btn text-secondary px-4" style="background-color: transparent; border: 1px solid var(--border-color); border-left: none; border-radius: 0 8px 8px 0;">Danh sách (@scheduleList.Count)</button>
        </div>
        
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 px-4" style="font-weight: 500; border-radius: 8px;">
                <i class="fa-solid fa-plus"></i> Tạo ca
            </a>
        }
    </div>
</div>

<!-- Chế độ 1: Lịch tuần -->
<div id="weekViewContainer" class="card-dark p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-bordered mb-0 custom-schedule-table" style="border-color: var(--border-color);">
            <thead>
                <tr>
                    <th class="text-secondary fw-semibold text-center align-middle" style="width: 10%; background-color: rgba(255, 255, 255, 0.02);">CA LÀM</th>
                    @for (int i = 0; i < 7; i++)
                    {
                        var currentDate = startOfWeek.AddDays(i);
                        var isToday = currentDate.Date == today.Date;
                        
                        <th class="text-center py-3 position-relative" style="width: 12.8%; @(isToday ? "background-color: rgba(27, 185, 154, 0.08);" : "background-color: rgba(255, 255, 255, 0.02);")">
                            <div style="@(isToday ? "color: var(--accent-green); font-weight: bold;" : "color: var(--text-secondary);") margin-bottom: 4px;">@dayNames[(int)daysOfWeek[i]]</div>
                            <div style="@(isToday ? "color: var(--accent-green); font-weight: bold;" : "color: var(--text-secondary);") font-size: 0.85rem;">@currentDate.ToString("dd/MM")</div>
                            @if (isToday)
                            {
                                <div style="width: 6px; height: 6px; background-color: var(--accent-green); border-radius: 50%; position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%);"></div>
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td class="p-3">
                            <div class="p-3 rounded" style="background-color: rgba(255, 255, 255, 0.03); border-left: 3px solid var(--@(row.ColorClass));">
                                <div class="fw-bold mb-2" style="color: var(--@(row.ColorClass));">@row.TenCa</div>
                                <div class="text-secondary" style="font-size: 0.75rem;"><i class="fa-solid fa-circle" style="font-size: 0.4rem; color: var(--@(row.ColorClass)); margin-right: 4px;"></i>@Html.Raw(row.ThoiGian.Replace(" - ", "<br>&nbsp;&nbsp;&nbsp;&nbsp;-<br>&nbsp;&nbsp;&nbsp;"))</div>
                            </div>
                        </td>
                        
                        @foreach (var day in daysOfWeek)
                        {
                            var cell = row.Days[day];
                            <td class="p-2 align-top">
                                @if (cell.NhanVienNames.Any())
                                {
                                    foreach (var nv in cell.NhanVienNames)
                                    {
                                        string shortName = nv.Length > 18 ? nv.Substring(0, 15) + "..." : nv;
                                        string colorName = row.ColorClass.Replace("accent-", "");
                                        <div class="shift-item @colorName" title="@nv">@shortName</div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center text-secondary pt-4">—</div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Chế độ 2: Danh sách phân ca -->
<div id="listViewContainer" class="card-dark p-0 overflow-hidden d-none">
    <table class="table table-borderless mb-0 custom-table">
        <thead style="border-bottom: 1px solid var(--border-color);">
            <tr>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">MÃ LỊCH</th>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">NGÀY LÀM</th>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">CA LÀM VIỆC</th>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">NHÂN VIÊN</th>
                <th class="text-secondary fw-semibold py-3 px-4 text-center" style="font-size: 0.75rem;">TRẠNG THÁI</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in scheduleList)
            {
                string stColor = item.TrangThai == "Hoàn thành" ? "var(--accent-green)" : "var(--accent-purple)";
                <tr style="border-bottom: 1px solid var(--border-color);">
                    <td class="px-4 py-3 text-secondary">@item.MaLich</td>
                    <td class="px-4 py-3 text-white fw-semibold">@item.NgayLam.ToString("dd/MM/yyyy")</td>
                    <td class="px-4 py-3 text-secondary">@item.TenCa (@item.ThoiGian)</td>
                    <td class="px-4 py-3 text-white">@item.TenNhanVien <span class="text-secondary" style="font-size:0.8rem;">(@item.MaNhanVien)</span></td>
                    <td class="px-4 py-3 text-center">
                        <span class="badge rounded-pill" style="background: rgba(146,119,248,0.15); color: @stColor; padding: 6px 12px;">@item.TrangThai</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <style>
        .custom-schedule-table th, 
        .custom-schedule-table td {
            border-color: var(--border-color);
        }
        .shift-item {
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 500;
            margin-bottom: 8px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .shift-item:hover {
            filter: brightness(1.15);
        }
        .shift-item.orange {
            background-color: rgba(245, 158, 11, 0.12);
            color: var(--accent-orange);
            border: 1px solid rgba(245, 158, 11, 0.25);
        }
        .shift-item.purple {
            background-color: rgba(146, 119, 248, 0.12);
            color: var(--accent-purple);
            border: 1px solid rgba(146, 119, 248, 0.25);
        }
        .shift-item.green {
            background-color: rgba(27, 185, 154, 0.12);
            color: var(--accent-green);
            border: 1px solid rgba(27, 185, 154, 0.25);
        }
    </style>
    <script>
        function toggleScheduleView(mode) {
            const weekBox = document.getElementById('weekViewContainer');
            const listBox = document.getElementById('listViewContainer');
            const btnWeek = document.getElementById('btnViewWeek');
            const btnList = document.getElementById('btnViewList');

            if (mode === 'week') {
                weekBox.classList.remove('d-none');
                listBox.classList.add('d-none');
                btnWeek.style.backgroundColor = 'var(--accent-purple)';
                btnWeek.classList.replace('text-secondary', 'text-white');
                btnList.style.backgroundColor = 'transparent';
                btnList.classList.replace('text-white', 'text-secondary');
            } else {
                weekBox.classList.add('d-none');
                listBox.classList.remove('d-none');
                btnList.style.backgroundColor = 'var(--accent-purple)';
                btnList.classList.replace('text-secondary', 'text-white');
                btnWeek.style.backgroundColor = 'transparent';
                btnWeek.classList.replace('text-white', 'text-secondary');
            }
        }
    </script>
}
