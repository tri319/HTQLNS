@inject HTQLNS.Models.ApplicationDbContext DbContext
@{
    var pendingAccountCount = DbContext.TaiKhoans.Count(t => t.TrangThai == "Chờ duyệt");
    var pendingLeaveCount = DbContext.DonXinNghis.Count(d => d.TrangThai == "Chờ duyệt") + DbContext.YeuCauDoiCas.Count(y => y.TrangThai == "Chờ duyệt");
    var totalNotifications = pendingAccountCount + pendingLeaveCount;
    string[] vnDays = { "Chủ Nhật", "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy" };
    var now = DateTime.Now;
    string todayVn = $"{vnDays[(int)now.DayOfWeek]}, {now:dd} tháng {now:MM} năm {now:yyyy}";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StarZone HRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HTQLNS.styles.css" asp-append-version="true" />
</head>
<body>
    
    <!-- Sidebar -->
    <aside class="app-sidebar" id="appSidebar">
        <div class="sidebar-header">
            <div class="logo-icon">
                <i class="fa-solid fa-star"></i>
            </div>
            <div>
                <div class="logo-text">StarZone HRM</div>
                <div class="logo-version">V3.2.1</div>
            </div>
        </div>
        
        <ul class="sidebar-menu">
            <li class="menu-title">Điều hướng</li>
            
            <li class="menu-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                <a asp-controller="Home" asp-action="Index" class="menu-link">
                    <i class="fa-solid fa-border-all menu-icon"></i>
                    <span>Tổng quan</span>
                </a>
            </li>
            
            @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Manager"))
            {
                <li class="menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Employee" ? "active" : "")">
                    <a asp-controller="Employee" asp-action="Index" class="menu-link">
                        <i class="fa-solid fa-users menu-icon"></i>
                        <span>Nhân sự</span>
                    </a>
                </li>
            }
            
            @if (User.IsInRole("Admin") || User.IsInRole("HR"))
            {
                <li class="menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Department" ? "active" : "")">
                    <a asp-controller="Department" asp-action="Index" class="menu-link">
                        <i class="fa-solid fa-building-user menu-icon"></i>
                        <span>Phòng ban & Chức vụ</span>
                    </a>
                </li>
            }
            
            <li class="menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Schedule" ? "active" : "")">
                <a asp-controller="Schedule" asp-action="Index" class="menu-link">
                    <i class="fa-solid fa-calendar-days menu-icon"></i>
                    <span>Lịch & Phân ca</span>
                </a>
            </li>
            
            <li class="menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Leave" ? "active" : "")">
                <a asp-controller="Leave" asp-action="Index" class="menu-link">
                    <i class="fa-solid fa-file-signature menu-icon"></i>
                    <span>Đơn xin nghỉ</span>
                    @if (User.IsInRole("Admin") && pendingLeaveCount > 0)
                    {
                        <span class="badge bg-danger ms-auto">@pendingLeaveCount</span>
                    }
                </a>
            </li>
            
            <li class="menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Attendance" ? "active" : "")">
                <a asp-controller="Attendance" asp-action="Index" class="menu-link">
                    <i class="fa-solid fa-clock-rotate-left menu-icon"></i>
                    <span>Chấm công</span>
                </a>
            </li>
            
            @if (User.IsInRole("Admin") || User.IsInRole("HR"))
            {
                <li class="menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Report" ? "active" : "")">
                    <a asp-controller="Report" asp-action="Index" class="menu-link">
                        <i class="fa-solid fa-chart-line menu-icon"></i>
                        <span>Báo cáo</span>
                    </a>
                </li>
            }

            @if (User.IsInRole("Admin"))
            {
                <li class="menu-title" style="margin-top:8px;">Quản trị hệ thống</li>
                <li class="menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Action"]?.ToString() == "PendingAccounts" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="PendingAccounts" class="menu-link">
                        <i class="fa-solid fa-user-clock menu-icon" style="color:#f59e0b;"></i>
                        <span>Duyệt tài khoản</span>
                        @if (pendingAccountCount > 0)
                        {
                            <span class="badge bg-warning text-dark ms-auto">@pendingAccountCount</span>
                        }
                    </a>
                </li>
                <li class="menu-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Action"]?.ToString() == "AllAccounts" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="AllAccounts" class="menu-link">
                        <i class="fa-solid fa-users-gear menu-icon" style="color:#a881e6;"></i>
                        <span>Quản lý tài khoản</span>
                    </a>
                </li>
            }
        </ul>
        
        <div class="sidebar-footer">
            <a asp-controller="Account" asp-action="Logout" class="text-decoration-none" title="Bấm để đăng xuất / Đổi tài khoản">
                <div class="user-profile-sm">
                    <div class="avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")</div>
                    <div class="user-info">
                        <p class="user-name">@(User.FindFirst("HoTen")?.Value ?? User.Identity?.Name ?? "Người dùng")</p>
                        <p class="user-role">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User")</p>
                    </div>
                    <i class="fa-solid fa-arrow-right-from-bracket text-secondary" style="font-size: 0.85rem;" title="Đăng xuất"></i>
                </div>
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="app-main">
        <!-- Topbar -->
        <header class="app-topbar">
            <div class="page-title-wrapper">
                <div class="page-breadcrumb">
                    StarZone HRM &bull; <span>@ViewData["Title"]</span>
                </div>
                <div class="page-date">@todayVn</div>
            </div>
            
            <div class="topbar-actions">
                <div class="search-bar">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input type="text" id="globalTableSearch" class="search-input" placeholder="Tìm nhanh trên trang..." />
                </div>
                
                <div class="dropdown">
                    <div class="notification-btn" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa-solid fa-bell"></i>
                        @if (totalNotifications > 0)
                        {
                            <span class="badge-notification">@totalNotifications</span>
                        }
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end p-2" style="background:#1a1b2e; border:1px solid var(--border-color); min-width:280px;">
                        <li class="px-3 py-2 text-white fw-semibold border-bottom" style="border-color:var(--border-color) !important;">Thông báo hệ thống</li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li>
                                <a class="dropdown-item text-secondary py-2" asp-controller="Admin" asp-action="PendingAccounts">
                                    <i class="fa-solid fa-user-clock text-warning me-2"></i> @pendingAccountCount tài khoản đang chờ duyệt
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item text-secondary py-2" asp-controller="Leave" asp-action="Index">
                                    <i class="fa-solid fa-file-signature text-danger me-2"></i> @pendingLeaveCount đơn nghỉ/đổi ca chờ duyệt
                                </a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a class="dropdown-item text-secondary py-2" asp-controller="Attendance" asp-action="Index">
                                    <i class="fa-solid fa-clock text-success me-2"></i> Nhắc nhở: Check-in ca làm hôm nay
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                
                <div class="user-profile-sm" style="padding: 6px 12px; background: transparent; border: 1px solid var(--border-color);">
                    <div class="avatar" style="width: 28px; height: 28px; font-size: 0.8rem;">@(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")</div>
                    <div class="user-info">
                        <p class="user-name" style="font-size: 0.8rem;">@(User.FindFirst("HoTen")?.Value ?? User.Identity?.Name ?? "Người dùng")</p>
                        <p class="user-role" style="font-size: 0.7rem;">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User")</p>
                    </div>
                </div>
            </div>
        </header>

        <!-- Page Body -->
        <div class="page-content">
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Tìm kiếm nhanh trên mọi bảng dữ liệu của trang hiện tại
        document.getElementById('globalTableSearch')?.addEventListener('input', function (e) {
            const keyword = e.target.value.toLowerCase().trim();
            const rows = document.querySelectorAll('table tbody tr');
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(keyword) ? '' : 'none';
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
