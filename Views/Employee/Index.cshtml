@model IEnumerable<HTQLNS.Models.NhanVien>
@{
    ViewData["Title"] = "Nhân sự";
    var phongBans = ViewBag.PhongBans as Dictionary<string, string> ?? new Dictionary<string, string>();
    var chucVus = ViewBag.ChucVus as Dictionary<string, string> ?? new Dictionary<string, string>();
    string selectedPB = ViewBag.SelectedPhongBan ?? "";
    var colors = new[] { "#a881e6", "#1bb99a", "#f59e0b", "#3b82f6", "#ec4899" };
    int idx = 0;
}

@if (TempData["Success"] != null)
{
    <div class="alert mb-4" style="background: rgba(27,185,154,.15); border:1px solid #1bb99a; color:#1bb99a; border-radius:8px; padding:12px 16px;">
        <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div class="d-flex gap-3 align-items-center flex-wrap">
        <div class="btn-group" role="group">
            <a asp-action="Index" class="btn px-4 @(string.IsNullOrEmpty(selectedPB) ? "text-white" : "text-secondary")"
               style="background-color: @(string.IsNullOrEmpty(selectedPB) ? "var(--accent-purple)" : "transparent"); border: 1px solid var(--border-color); border-radius: 8px 0 0 8px;">
                Tất cả (@Model.Count())
            </a>
            <button type="button" class="btn text-secondary px-4" onclick="filterStatus('all')" style="background-color: transparent; border: 1px solid var(--border-color); border-left: none; border-radius: 0 8px 8px 0;">
                Đang làm việc
            </button>
        </div>
        
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <select name="phongBan" class="form-select text-white" style="background-color: var(--card-bg); border-color: var(--border-color); width: 220px;" onchange="this.form.submit()">
                <option value="">-- Tất cả phòng ban --</option>
                @foreach (var pb in phongBans)
                {
                    if (selectedPB == pb.Key)
                    {
                        <option value="@pb.Key" selected>@pb.Value</option>
                    }
                    else
                    {
                        <option value="@pb.Key">@pb.Value</option>
                    }
                }
            </select>
        </form>
    </div>
    
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 px-4" style="font-weight: 500; border-radius: 8px;">
        <i class="fa-solid fa-plus"></i> Thêm nhân viên
    </a>
</div>

<div class="card-dark p-0 overflow-hidden">
    <table class="table table-borderless mb-0 custom-table" id="employeeTable">
        <thead style="border-bottom: 1px solid var(--border-color);">
            <tr>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">MÃ NV</th>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">NHÂN VIÊN</th>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">NGÀY SINH</th>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">SĐT</th>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">PHÒNG BAN</th>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">CHỨC VỤ</th>
                <th class="text-secondary fw-semibold py-3 px-4 text-center" style="font-size: 0.75rem;">TRẠNG THÁI</th>
                <th class="text-secondary fw-semibold py-3 px-4 text-end" style="font-size: 0.75rem;">THAO TÁC</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                string tenPB = phongBans.ContainsKey(item.MaPhongBan) ? phongBans[item.MaPhongBan] : "N/A";
                string tenCV = chucVus.ContainsKey(item.MaChucVu) ? chucVus[item.MaChucVu] : "N/A";
                string avatarColor = colors[(idx++) % colors.Length];
                string avatarChar = string.IsNullOrEmpty(item.HoTen) ? "U" : item.HoTen.Substring(item.HoTen.LastIndexOf(' ') + 1, 1).ToUpper();

                <tr style="border-bottom: 1px solid var(--border-color);">
                    <td class="px-4 py-3 align-middle text-secondary fw-semibold">@item.MaNhanVien</td>
                    <td class="px-4 py-3 align-middle">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar" style="background-color: @avatarColor;">@avatarChar</div>
                            <div>
                                <div class="fw-semibold text-white">@item.HoTen</div>
                                <div class="text-secondary" style="font-size: 0.75rem;">@(item.Email ?? "—")</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-4 py-3 align-middle text-secondary">@(item.NgaySinh?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td class="px-4 py-3 align-middle text-secondary">@(item.SDT ?? "—")</td>
                    <td class="px-4 py-3 align-middle">
                        <span class="badge rounded-pill" style="background-color: rgba(255, 255, 255, 0.05); color: var(--text-primary); font-weight: normal; padding: 6px 12px; border: 1px solid var(--border-color);">@tenPB</span>
                    </td>
                    <td class="px-4 py-3 align-middle text-secondary">@tenCV</td>
                    <td class="px-4 py-3 align-middle text-center">
                        <span class="badge rounded-pill" style="background-color: rgba(27, 185, 154, 0.15); color: var(--accent-green); padding: 6px 12px;"><i class="fa-solid fa-circle" style="font-size: 0.4rem; margin-right: 4px;"></i> Chính thức</span>
                    </td>
                    <td class="px-4 py-3 align-middle text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Edit" asp-route-id="@item.MaNhanVien" class="btn btn-sm btn-icon" title="Chỉnh sửa"><i class="fa-solid fa-pen text-secondary"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.MaNhanVien" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa nhân viên @item.HoTen?');">
                                <button type="submit" class="btn btn-sm btn-icon" title="Xóa"><i class="fa-solid fa-trash text-secondary"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <style>
        .custom-table th {
            background-color: rgba(255, 255, 255, 0.02);
            border-bottom: 1px solid var(--border-color);
        }
        .btn-icon {
            background: transparent;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-icon:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }
    </style>
}
