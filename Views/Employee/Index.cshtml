@model IEnumerable<HTQLNS.Models.NhanVien>
@{
    ViewData["Title"] = "Nhân viên";
    var phongBans = ViewBag.PhongBans as Dictionary<string, string> ?? new Dictionary<string, string>();
    var chucVus = ViewBag.ChucVus as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex gap-3">
        <div class="btn-group" role="group">
            <button type="button" class="btn text-white px-4" style="background-color: var(--accent-purple); border: none; border-radius: 8px 0 0 8px;">Tất cả</button>
            <button type="button" class="btn text-secondary px-4" style="background-color: transparent; border: 1px solid var(--border-color); border-left: none; border-right: none;">Chính thức</button>
            <button type="button" class="btn text-secondary px-4" style="background-color: transparent; border: 1px solid var(--border-color); border-left: none; border-right: none;">Thử việc</button>
            <button type="button" class="btn text-secondary px-4" style="background-color: transparent; border: 1px solid var(--border-color); border-radius: 0 8px 8px 0;">Đã nghỉ</button>
        </div>
        
        <select class="form-select text-white" style="background-color: var(--card-bg); border-color: var(--border-color); width: 200px;">
            <option>Tất cả phòng ban</option>
            @foreach (var pb in phongBans.Values)
            {
                <option>@pb</option>
            }
        </select>
    </div>
    
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 px-4" style="font-weight: 500; border-radius: 8px;">
        <i class="fa-solid fa-plus"></i> Thêm nhân viên
    </a>
</div>

<div class="card-dark p-0 overflow-hidden">
    <table class="table table-borderless mb-0 custom-table">
        <thead style="border-bottom: 1px solid var(--border-color);">
            <tr>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">MÃ NV</th>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">NHÂN VIÊN</th>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">SĐT</th>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">PHÒNG BAN</th>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">CHỨC VỤ</th>
                <th class="text-secondary fw-semibold py-3 px-4 text-center" style="font-size: 0.75rem;">TRẠNG THÁI</th>
                <th class="text-secondary fw-semibold py-3 px-4 text-end" style="font-size: 0.75rem;">THAO TÁC</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                string tenPB = phongBans.ContainsKey(item.MaPhongBan) ? phongBans[item.MaPhongBan] : "N/A";
                string tenCV = chucVus.ContainsKey(item.MaChucVu) ? chucVus[item.MaChucVu] : "N/A";
                string avatarColor = "#a881e6"; // Randomize later if needed
                string avatarChar = string.IsNullOrEmpty(item.HoTen) ? "U" : item.HoTen.Substring(item.HoTen.LastIndexOf(' ') + 1, 1).ToUpper();

                <tr style="border-bottom: 1px solid var(--border-color);">
                    <td class="px-4 py-4 align-middle text-secondary">@item.MaNhanVien</td>
                    <td class="px-4 py-4 align-middle">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar" style="background-color: @avatarColor;">@avatarChar</div>
                            <div>
                                <div class="fw-semibold">@item.HoTen</div>
                                <div class="text-secondary" style="font-size: 0.75rem;">@item.Email</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-4 py-4 align-middle text-secondary">@item.SDT</td>
                    <td class="px-4 py-4 align-middle">
                        <span class="badge rounded-pill" style="background-color: rgba(255, 255, 255, 0.05); color: var(--text-primary); font-weight: normal; padding: 6px 12px; border: 1px solid var(--border-color);">@tenPB</span>
                    </td>
                    <td class="px-4 py-4 align-middle text-secondary">@tenCV</td>
                    <td class="px-4 py-4 align-middle text-center">
                        <span class="badge rounded-pill" style="background-color: rgba(27, 185, 154, 0.15); color: var(--accent-green); padding: 6px 12px;"><i class="fa-solid fa-circle" style="font-size: 0.4rem; margin-right: 4px;"></i> Chính thức</span>
                    </td>
                    <td class="px-4 py-4 align-middle text-end">
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Edit" asp-route-id="@item.MaNhanVien" class="btn btn-sm btn-icon"><i class="fa-solid fa-pen text-secondary"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.MaNhanVien" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa nhân viên này?');">
                                <button type="submit" class="btn btn-sm btn-icon"><i class="fa-solid fa-trash text-secondary"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <style>
        .custom-table th {
            background-color: rgba(255, 255, 255, 0.02);
            border-bottom: 1px solid var(--border-color);
        }
        .btn-icon {
            background: transparent;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-icon:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }
    </style>
}
