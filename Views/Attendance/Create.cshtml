@model HTQLNS.Models.ChamCong
@{
    ViewData["Title"] = "Chấm Công Thủ Công";
    var lichPhanCongs = ViewBag.LichPhanCongs as IEnumerable<HTQLNS.Models.LichPhanCong>;
    var nvDict = ViewBag.NhanVienDict as Dictionary<string, string> ?? new Dictionary<string, string>();
    var caDict = ViewBag.LoaiCaDict as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a asp-action="Index" class="btn btn-dark" style="background-color: var(--card-bg); border-color: var(--border-color);"><i class="fa-solid fa-arrow-left"></i></a>
    <h4 class="mb-0 fw-bold">Thêm Chấm Công Thủ Công</h4>
</div>

<div class="card-dark" style="max-width: 650px;">
    <form asp-action="Create" method="post">
        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label text-secondary">Lịch Phân Công (Nhân viên - Ca làm)</label>
                <select asp-for="MaLich" class="form-select text-white bg-dark border-secondary" required>
                    <option value="">-- Chọn lịch làm việc --</option>
                    @if (lichPhanCongs != null)
                    {
                        foreach (var lich in lichPhanCongs)
                        {
                            string tenNV = nvDict.ContainsKey(lich.MaNhanVien) ? nvDict[lich.MaNhanVien] : lich.MaNhanVien;
                            string tenCa = caDict.ContainsKey(lich.MaLoaiCa) ? caDict[lich.MaLoaiCa] : lich.MaLoaiCa;
                            <option value="@lich.MaLich">@tenNV (@lich.MaNhanVien) — @tenCa (@lich.NgayLam.ToString("dd/MM/yyyy"))</option>
                        }
                    }
                </select>
            </div>
            
            <div class="col-md-6 mb-3">
                <label class="form-label text-secondary">Thời gian Check-in</label>
                <input asp-for="ThoiGianChekin" type="datetime-local" class="form-control text-white bg-dark border-secondary" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            
            <div class="col-md-6 mb-4">
                <label class="form-label text-secondary">Thời gian Check-out</label>
                <input asp-for="ThoiGianCheckout" type="datetime-local" class="form-control text-white bg-dark border-secondary" />
                <div class="form-text text-secondary">Để trống nếu nhân viên đang trong ca</div>
            </div>
        </div>
        
        <div class="d-flex justify-content-end gap-3 pt-3" style="border-top: 1px solid var(--border-color);">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
            <button type="submit" class="btn btn-primary px-4">Lưu chấm công</button>
        </div>
    </form>
</div>
