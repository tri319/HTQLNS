@model HTQLNS.Models.PhongBan
@{
    ViewData["Title"] = "Thêm Phòng Ban";
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a asp-action="Index" class="btn btn-dark" style="background-color: var(--card-bg); border-color: var(--border-color);"><i class="fa-solid fa-arrow-left"></i></a>
    <h4 class="mb-0 fw-bold">Thêm Phòng Ban Mới</h4>
</div>

<div class="card-dark" style="max-width: 600px;">
    <form asp-action="Create" method="post">
        <div class="mb-4">
            <label class="form-label text-secondary">Tên phòng ban</label>
            <input asp-for="TenPhongBan" class="form-control text-white bg-dark border-secondary" required placeholder="Nhập tên phòng ban (VD: Lễ tân)..." />
        </div>
        
        <div class="d-flex justify-content-end gap-3 pt-3" style="border-top: 1px solid var(--border-color);">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
            <button type="submit" class="btn btn-primary px-4">Lưu phòng ban</button>
        </div>
    </form>
</div>
