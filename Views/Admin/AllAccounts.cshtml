@model List<HTQLNS.Models.TaiKhoan>
@{
    ViewData["Title"] = "Quản lý tài khoản";
    var vaiTros = ViewBag.VaiTros as List<HTQLNS.Models.VaiTro>;
}

<div class="content-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-heading">Quản lý tài khoản</h1>
        <p class="text-secondary">Xem và quản lý tất cả tài khoản trong hệ thống</p>
    </div>
    <a asp-action="PendingAccounts" class="btn btn-sm" style="background:#f59e0b;color:white;">
        <i class="fa-solid fa-user-clock me-1"></i>Tài khoản chờ duyệt
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert mb-4" style="background:rgba(27,185,154,.15);border-color:#1bb99a;color:#1bb99a;">
        <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
    </div>
}

<div class="stats-card p-0" style="overflow:hidden;">
    <table class="table table-dark mb-0" style="--bs-table-bg:transparent;--bs-table-hover-bg:rgba(255,255,255,.04);">
        <thead style="border-bottom:1px solid var(--border-color);">
            <tr>
                <th class="px-4 py-3 text-secondary fw-normal">Tài khoản</th>
                <th class="px-4 py-3 text-secondary fw-normal">Nhân viên</th>
                <th class="px-4 py-3 text-secondary fw-normal">Vai trò</th>
                <th class="px-4 py-3 text-secondary fw-normal">Trạng thái</th>
                <th class="px-4 py-3 text-secondary fw-normal text-end">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tk in Model)
            {
                var statusColor = tk.TrangThai switch
                {
                    "Hoạt động" => "#1bb99a",
                    "Chờ duyệt" => "#f59e0b",
                    _ => "#f34343"
                };
                <tr style="border-color:var(--border-color);">
                    <td class="px-4 py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#a881e6,#7c5cbf);display:flex;align-items:center;justify-content:center;font-weight:700;color:white;flex-shrink:0;">
                                @(string.IsNullOrEmpty(tk.HoTen ?? tk.NhanVien?.HoTen) ? "?" : (tk.HoTen ?? tk.NhanVien?.HoTen ?? "?").Substring(0,1).ToUpper())
                            </div>
                            <div>
                                <div class="text-white" style="font-size:.95rem;">@(tk.HoTen ?? tk.NhanVien?.HoTen ?? "—")</div>
                                <div class="text-secondary" style="font-size:.82rem;">@tk.TenDangNhap</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-4 py-3 text-secondary">@(tk.MaNhanVien ?? "Chưa cấp")</td>
                    <td class="px-4 py-3">
                        <form asp-action="ChangeRole" method="post" class="d-flex gap-2 align-items-center">
                            <input type="hidden" name="maTaiKhoan" value="@tk.MaTaiKhoan" />
                            <select name="maVaiTro" class="form-select form-select-sm" style="background:#0c0d14;border-color:var(--border-color);color:white;width:auto;"
                                    onchange="this.form.submit()">
                                @if (vaiTros != null)
                                {
                                    @foreach (var vt in vaiTros)
                                    {
                                        if (tk.MaVaiTro == vt.MaVaiTro)
                                        {
                                            <option value="@vt.MaVaiTro" selected>@vt.TenVaiTro</option>
                                        }
                                        else
                                        {
                                            <option value="@vt.MaVaiTro">@vt.TenVaiTro</option>
                                        }
                                    }
                                }
                            </select>
                        </form>
                    </td>
                    <td class="px-4 py-3">
                        <span class="badge" style="background:@(statusColor)22;color:@statusColor;border:1px solid @statusColor;">
                            @tk.TrangThai
                        </span>
                    </td>
                    <td class="px-4 py-3 text-end">
                        @if (tk.TrangThai != "Chờ duyệt")
                        {
                            <form asp-action="ToggleAccountStatus" method="post" class="d-inline">
                                <input type="hidden" name="maTaiKhoan" value="@tk.MaTaiKhoan" />
                                <button type="submit" class="btn btn-sm"
                                    style="background:@(tk.TrangThai == "Hoạt động" ? "rgba(243,67,67,.15)" : "rgba(27,185,154,.15)");color:@(tk.TrangThai == "Hoạt động" ? "#f34343" : "#1bb99a");border:none;">
                                    @(tk.TrangThai == "Hoạt động" ? "Khóa" : "Mở khóa")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
