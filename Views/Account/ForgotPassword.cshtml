@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu - StarZone HRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background-color: #0c0d14; /* Slightly darker than sidebar */
        }
        .login-container {
            width: 100%;
            max-width: 480px;
            padding: 40px;
        }
        .brand-header {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 60px;
        }
        .logo-icon-lg {
            width: 48px;
            height: 48px;
            background-color: var(--accent-purple);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
        }
        .brand-text {
            font-size: 1.5rem;
            font-weight: 700;
            color: white;
            letter-spacing: -0.5px;
        }
        
        .form-control-dark {
            background-color: var(--sidebar-bg);
            border: 1px solid var(--border-color);
            color: white;
            border-radius: 8px;
            padding: 12px 16px 12px 45px;
            height: 50px;
            font-size: 1rem;
        }
        .form-control-dark:focus {
            background-color: var(--sidebar-bg);
            border-color: var(--accent-purple);
            color: white;
            box-shadow: 0 0 0 3px rgba(146, 119, 248, 0.2);
        }
        
        .input-icon-wrapper {
            position: relative;
            margin-bottom: 24px;
        }
        .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-secondary);
            font-size: 1.1rem;
        }
        
        .form-label {
            color: var(--text-secondary);
            font-size: 0.9rem;
            font-weight: 500;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
        }
        
        .btn-login {
            background-color: var(--accent-purple);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 12px;
            width: 100%;
            font-weight: 600;
            font-size: 1rem;
            margin-top: 16px;
            height: 50px;
            transition: all 0.2s;
        }
        .btn-login:hover {
            background-color: var(--accent-purple-hover);
            color: white;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="brand-header">
            <div class="logo-icon-lg">
                <i class="fa-solid fa-star"></i>
            </div>
            <div class="brand-text">StarZone HRM</div>
        </div>
        
        <h2 class="mb-2 text-white fw-bold">Khôi phục mật khẩu</h2>
        <p class="text-secondary mb-4 pb-2" style="font-size: 1.05rem;">Nhập email của bạn và chúng tôi sẽ gửi cho bạn một mật khẩu mới.</p>
        
        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            @if(ViewBag.Error != null)
            {
                <div class="alert alert-danger" style="background-color: rgba(220, 53, 69, 0.1); border-color: #dc3545; color: #ff6b72;">
                    @ViewBag.Error
                </div>
            }
            @if(ViewBag.Success != null)
            {
                <div class="alert alert-success" style="background-color: rgba(25, 135, 84, 0.1); border-color: #198754; color: #75b798;">
                    @ViewBag.Success
                </div>
            }
            <div class="mb-3">
                <label class="form-label">Email</label>
                <div class="input-icon-wrapper">
                    <i class="fa-regular fa-envelope input-icon"></i>
                    <input type="email" name="email" class="form-control form-control-dark" placeholder="Nhập email của bạn" required>
                </div>
            </div>
            
            <button type="submit" class="btn btn-login mb-4">
                Gửi mật khẩu mới <i class="fa-solid fa-paper-plane ms-2"></i>
            </button>

            <div class="text-center">
                <a asp-action="Login" class="text-decoration-none" style="color: var(--text-secondary); font-weight: 500;">
                    <i class="fa-solid fa-arrow-left me-1"></i> Quay lại đăng nhập
                </a>
            </div>
        </form>
    </div>

</body>
</html>
