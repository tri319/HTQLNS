@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - StarZone HRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background-color: #0c0d14; /* Slightly darker than sidebar */
        }
        .login-container {
            width: 100%;
            max-width: 480px;
            padding: 40px;
        }
        .brand-header {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 60px;
        }
        .logo-icon-lg {
            width: 48px;
            height: 48px;
            background-color: var(--accent-purple);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
        }
        .brand-text {
            font-size: 1.5rem;
            font-weight: 700;
            color: white;
            letter-spacing: -0.5px;
        }
        
        .form-control-dark {
            background-color: var(--sidebar-bg);
            border: 1px solid var(--border-color);
            color: white;
            border-radius: 8px;
            padding: 12px 16px 12px 45px;
            height: 50px;
            font-size: 1rem;
        }
        .form-control-dark:focus {
            background-color: var(--sidebar-bg);
            border-color: var(--accent-purple);
            color: white;
            box-shadow: 0 0 0 3px rgba(146, 119, 248, 0.2);
        }
        
        .input-icon-wrapper {
            position: relative;
            margin-bottom: 24px;
        }
        .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-secondary);
            font-size: 1.1rem;
        }
        .password-toggle {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-secondary);
            cursor: pointer;
        }
        
        .form-label {
            color: var(--text-secondary);
            font-size: 0.9rem;
            font-weight: 500;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
        }
        
        .btn-login {
            background-color: var(--accent-purple);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 12px;
            width: 100%;
            font-weight: 600;
            font-size: 1rem;
            margin-top: 16px;
            height: 50px;
            transition: all 0.2s;
        }
        .btn-login:hover {
            background-color: var(--accent-purple-hover);
            color: white;
        }
        
        .form-check-input {
            background-color: transparent;
            border-color: var(--text-secondary);
        }
        .form-check-input:checked {
            background-color: var(--accent-purple);
            border-color: var(--accent-purple);
        }
        .form-check-label {
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        
        .demo-credentials {
            background-color: var(--sidebar-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
            margin-top: 40px;
        }
        .demo-title {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
            margin-bottom: 12px;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="brand-header">
            <div class="logo-icon-lg">
                <i class="fa-solid fa-star"></i>
            </div>
            <div class="brand-text">StarZone HRM</div>
        </div>
        
        <h2 class="mb-2 text-white fw-bold">Đăng nhập</h2>
        <p class="text-secondary mb-4 pb-2" style="font-size: 1.05rem;">Chào mừng trở lại! Vui lòng đăng nhập để tiếp tục.</p>
        
        <form asp-controller="Home" asp-action="Index" method="get">
            <div class="mb-3">
                <label class="form-label">Địa chỉ email</label>
                <div class="input-icon-wrapper">
                    <i class="fa-regular fa-envelope input-icon"></i>
                    <input type="email" class="form-control form-control-dark" placeholder="admin@starzone.vn" value="admin@starzone.vn">
                </div>
            </div>
            
            <div class="mb-3">
                <label class="form-label">
                    Mật khẩu
                    <a href="#" class="text-decoration-none" style="color: var(--accent-purple);">Quên mật khẩu?</a>
                </label>
                <div class="input-icon-wrapper">
                    <i class="fa-solid fa-lock input-icon" style="color: #f59e0b;"></i>
                    <input type="password" class="form-control form-control-dark" placeholder="••••••••" value="password">
                    <i class="fa-regular fa-eye password-toggle"></i>
                </div>
            </div>
            
            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" value="" id="rememberMe" checked>
                <label class="form-check-label" for="rememberMe">
                    Ghi nhớ đăng nhập trong 30 ngày
                </label>
            </div>
            
            <button type="submit" class="btn btn-login">
                Đăng nhập <i class="fa-solid fa-arrow-right ms-2"></i>
            </button>
        </form>
        
        <div class="demo-credentials">
            <div class="demo-title">TÀI KHOẢN DEMO</div>
            <div class="d-flex align-items-center mb-2" style="color: var(--text-secondary); font-size: 0.95rem;">
                <i class="fa-solid fa-envelope me-3" style="color: #64748b;"></i> admin@starzone.vn
            </div>
            <div class="d-flex align-items-center" style="color: var(--text-secondary); font-size: 0.95rem;">
                <i class="fa-solid fa-key me-3" style="color: #f59e0b;"></i> Nhập bất kỳ mật khẩu
            </div>
        </div>
    </div>

</body>
</html>
