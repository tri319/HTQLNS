@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bổ sung thông tin - StarZone HRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background-color: #0c0d14;
        }
        .login-container {
            width: 100%;
            max-width: 480px;
            padding: 40px;
        }
        .brand-header {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 40px;
        }
        .logo-icon-lg {
            width: 48px;
            height: 48px;
            background-color: var(--accent-purple);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
        }
        .brand-text {
            font-size: 1.5rem;
            font-weight: 700;
            color: white;
            letter-spacing: -0.5px;
        }
        .form-control-dark {
            background-color: var(--sidebar-bg);
            border: 1px solid var(--border-color);
            color: white;
            border-radius: 8px;
            padding: 12px 16px;
            height: 50px;
            font-size: 1rem;
        }
        .form-control-dark:focus {
            background-color: var(--sidebar-bg);
            border-color: var(--accent-purple);
            color: white;
            box-shadow: 0 0 0 3px rgba(146, 119, 248, 0.2);
        }
        .form-label {
            color: var(--text-secondary);
            font-size: 0.9rem;
            font-weight: 500;
            margin-bottom: 8px;
        }
        .btn-login {
            background-color: var(--accent-purple);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 12px;
            width: 100%;
            font-weight: 600;
            font-size: 1rem;
            margin-top: 16px;
            height: 50px;
            transition: all 0.2s;
        }
        .btn-login:hover {
            background-color: var(--accent-purple-hover);
            color: white;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="brand-header">
            <div class="logo-icon-lg">
                <i class="fa-solid fa-star"></i>
            </div>
            <div class="brand-text">StarZone HRM</div>
        </div>
        
        <h2 class="mb-2 text-white fw-bold">Hoàn thiện hồ sơ</h2>
        <p class="text-secondary mb-4 pb-2" style="font-size: 1.05rem;">
            Tài khoản <strong>@ViewBag.Email</strong> cần bổ sung thông tin để tiếp tục.
        </p>
        
        <form asp-controller="Account" asp-action="CompleteProfile" method="post">
            <div class="mb-3">
                <label class="form-label">Họ và tên</label>
                <input type="text" name="hoTen" class="form-control form-control-dark" value="@ViewBag.Name" required>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Ngày sinh</label>
                <input type="date" name="ngaySinh" class="form-control form-control-dark" required>
            </div>
            
            <div class="mb-4">
                <label class="form-label">Tạo mật khẩu (Sử dụng cho các chức năng xác thực)</label>
                <input type="password" name="matKhau" class="form-control form-control-dark" placeholder="Nhập mật khẩu mới" required>
            </div>
            
            <button type="submit" class="btn btn-login">
                Hoàn tất đăng ký <i class="fa-solid fa-check ms-2"></i>
            </button>
        </form>
    </div>

</body>
</html>
