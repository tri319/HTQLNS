                    <div style="height: 130px; width: 18px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 92%; width: 100%; background: var(--accent-purple); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-purple); font-weight: 600; font-size: 0.85rem;">96.2%</div>
                    <div class="text-secondary" style="font-size: 0.8rem;">T6</div>
                </div>
                <div class="text-center">
                    <div style="height: 130px; width: 18px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 85%; width: 100%; background: var(--accent-orange); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-orange); font-weight: 600; font-size: 0.85rem;">94.8%</div>
                    <div class="text-secondary" style="font-size: 0.8rem;">T7</div>
                </div>
                <div class="text-center">
                    <div style="height: 130px; width: 18px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 95%; width: 100%; background: var(--accent-green); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-green); font-weight: 600; font-size: 0.85rem;">97.1%</div>
                    <div class="text-secondary" style="font-size: 0.8rem;">T8</div>
                </div>
                <div class="text-center">
                    <div style="height: 130px; width: 18px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 82%; width: 100%; background: var(--accent-orange); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-orange); font-weight: 600; font-size: 0.85rem;">93.5%</div>
                    <div class="text-secondary" style="font-size: 0.8rem;">T9</div>
                </div>
                <div class="text-center">
                    <div style="height: 130px; width: 18px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 90%; width: 100%; background: var(--accent-purple); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-purple); font-weight: 600; font-size: 0.85rem;">95.4%</div>
                    <div class="text-secondary" style="font-size: 0.8rem;">T10</div>
                </div>
                <div class="text-center">
                    <div style="height: 130px; width: 18px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 98%; width: 100%; background: var(--accent-green); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-green); font-weight: 600; font-size: 0.85rem;">98.4%</div>
                    <div class="fw-bold" style="font-size: 0.8rem; color: white;">T11</div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card-dark h-100">
            <h5 class="mb-1 fw-bold">Tổng giờ làm thêm (OT)</h5>
            <p class="text-secondary mb-4" style="font-size: 0.85rem;">Giờ làm thêm theo tháng</p>
            
            <div style="height: 220px; display: flex; align-items: flex-end; justify-content: space-around; padding-bottom: 20px; border-bottom: 1px solid var(--border-color);">
