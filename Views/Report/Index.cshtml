            </div>
        </div>
    </div>
</div>

<!-- Tab 2: Báo cáo chi tiết theo phòng ban -->
<div id="reportDeptSection" class="card-dark p-0 overflow-hidden d-none">
    <table class="table table-borderless mb-0 custom-table">
        <thead style="border-bottom: 1px solid var(--border-color);">
            <tr>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">MÃ PB</th>
                <th class="text-secondary fw-semibold py-3 px-4" style="font-size: 0.75rem;">PHÒNG BAN</th>
                <th class="text-secondary fw-semibold py-3 px-4 text-center" style="font-size: 0.75rem;">SỐ NHÂN VIÊN</th>
                <th class="text-secondary fw-semibold py-3 px-4 text-center" style="font-size: 0.75rem;">TỔNG CA PHÂN CÔNG</th>
                <th class="text-secondary fw-semibold py-3 px-4 text-center" style="font-size: 0.75rem;">LƯỢT ĐÚNG GIỜ</th>
                <th class="text-secondary fw-semibold py-3 px-4 text-center" style="font-size: 0.75rem;">TỶ LỆ CHUYÊN CẦN</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in deptReports)
            {
                <tr style="border-bottom: 1px solid var(--border-color);">
                    <td class="px-4 py-3 text-secondary fw-semibold">@d.MaPhongBan</td>
                    <td class="px-4 py-3 text-white fw-semibold">@d.TenPhongBan</td>
                    <td class="px-4 py-3 text-center text-white">@d.SoNhanVien</td>
                    <td class="px-4 py-3 text-center text-secondary">@d.SoCaPhanCong ca</td>
                    <td class="px-4 py-3 text-center text-success fw-semibold">@d.SoDungGio</td>
                    <td class="px-4 py-3 text-center">
                        <span class="badge rounded-pill" style="background: rgba(27,185,154,0.15); color: var(--accent-green); padding: 6px 14px;">@d.TyLeChuyenCan%</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        function switchReportTab(tab, btn) {
            const buttons = document.querySelectorAll('#reportTabGroup button');
            buttons.forEach(b => {
                b.style.backgroundColor = 'transparent';
                b.classList.replace('text-white', 'text-secondary');
            });
            btn.style.backgroundColor = 'var(--accent-purple)';
            btn.classList.replace('text-secondary', 'text-white');

            const overSec = document.getElementById('reportOverviewSection');
            const deptSec = document.getElementById('reportDeptSection');
            if (tab === 'overview') {
                overSec.classList.remove('d-none');
                deptSec.classList.add('d-none');
            } else {
                overSec.classList.add('d-none');
                deptSec.classList.remove('d-none');
            }
        }
    </script>
}
