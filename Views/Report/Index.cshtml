@{
    ViewData["Title"] = "Báo cáo & Thống kê";
    var deptReports = ViewBag.DeptReports as List<HTQLNS.Controllers.DeptReportItem> ?? new List<HTQLNS.Controllers.DeptReportItem>();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div class="btn-group" role="group" id="reportTabGroup">
        <button type="button" onclick="switchReportTab('overview', this)" class="btn text-white px-4" style="background-color: var(--accent-purple); border: 1px solid var(--accent-purple); border-radius: 8px 0 0 8px;">Tổng quan</button>
        <button type="button" onclick="switchReportTab('dept', this)" class="btn text-secondary px-4" style="background-color: transparent; border: 1px solid var(--border-color); border-left: none; border-radius: 0 8px 8px 0;">Theo phòng ban</button>
    </div>
    
    <div class="d-flex gap-3">
        <select class="form-select text-white" style="background-color: var(--card-bg); border-color: var(--border-color); width: 160px;">
            <option>Tháng @DateTime.Now.ToString("MM/yyyy")</option>
            <option>Tháng @DateTime.Now.AddMonths(-1).ToString("MM/yyyy")</option>
            <option>Tháng @DateTime.Now.AddMonths(-2).ToString("MM/yyyy")</option>
        </select>
        <a asp-action="ExportReportCsv" class="btn d-flex align-items-center gap-2" style="background-color: rgba(146, 119, 248, 0.2); color: #d0c4ff; border: 1px solid rgba(146, 119, 248, 0.5); font-weight: 500; border-radius: 8px;">
            <i class="fa-solid fa-download"></i> Xuất báo cáo
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card-dark h-100" style="background: linear-gradient(180deg, rgba(27,185,154,0.1) 0%, var(--card-bg) 100%);">
            <div class="text-secondary fw-semibold mb-3" style="font-size: 0.75rem; letter-spacing: 0.5px;">TỶ LỆ ĐÚNG GIỜ</div>
            <div class="fw-bold mb-2" style="font-size: 2.5rem; color: var(--accent-green); line-height: 1;">@ViewBag.AttendanceRate%</div>
            <div class="text-secondary" style="font-size: 0.8rem;"><i class="fa-solid fa-arrow-up me-1" style="color: var(--accent-green);"></i> Tỷ lệ chuyên cần thực tế</div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card-dark h-100" style="background: linear-gradient(180deg, rgba(146,119,248,0.1) 0%, var(--card-bg) 100%);">
            <div class="text-secondary fw-semibold mb-3" style="font-size: 0.75rem; letter-spacing: 0.5px;">TỔNG GIỜ OT</div>
            <div class="fw-bold mb-2" style="font-size: 2.5rem; color: #d0c4ff; line-height: 1;">@ViewBag.TotalOT</div>
            <div class="text-secondary" style="font-size: 0.8rem;"><i class="fa-solid fa-clock me-1"></i> Giờ làm thêm trong tháng</div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card-dark h-100" style="background: linear-gradient(180deg, rgba(245,158,11,0.1) 0%, var(--card-bg) 100%);">
            <div class="text-secondary fw-semibold mb-3" style="font-size: 0.75rem; letter-spacing: 0.5px;">NGHỈ PHÉP ĐÃ DUYỆT</div>
            <div class="fw-bold mb-2" style="font-size: 2.5rem; color: var(--accent-orange); line-height: 1;">@ViewBag.ApprovedLeaves</div>
            <div class="text-secondary" style="font-size: 0.8rem;">@ViewBag.PendingLeaves đơn đang chờ duyệt</div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card-dark h-100" style="background: linear-gradient(180deg, rgba(56,189,248,0.1) 0%, var(--card-bg) 100%);">
            <div class="text-secondary fw-semibold mb-3" style="font-size: 0.75rem; letter-spacing: 0.5px;">TỔNG NHÂN SỰ</div>
            <div class="fw-bold mb-2" style="font-size: 2.5rem; color: #38bdf8; line-height: 1;">@ViewBag.TotalEmployees</div>
            <div class="text-secondary" style="font-size: 0.8rem;">Nhân sự chính thức</div>
        </div>
    </div>
</div>

<!-- Tab 1: Biểu đồ Tổng quan -->
