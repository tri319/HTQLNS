                        <div style="height: 85%; width: 100%; background: var(--accent-purple); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-purple); font-weight: 600; font-size: 0.85rem;">124h</div>
                    <div class="text-secondary" style="font-size: 0.8rem;">T6</div>
                </div>
                <div class="text-center">
                    <div style="height: 130px; width: 18px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 68%; width: 100%; background: var(--accent-purple); border-radius: 6px;"></div>
                    </div>
