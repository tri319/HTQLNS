                    </div>
                    <div style="color: var(--accent-purple); font-weight: 600; font-size: 0.85rem;">135h</div>
                    <div class="text-secondary" style="font-size: 0.8rem;">T8</div>
                </div>
                <div class="text-center">
                    <div style="height: 130px; width: 18px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 75%; width: 100%; background: var(--accent-purple); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-purple); font-weight: 600; font-size: 0.85rem;">110h</div>
                    <div class="text-secondary" style="font-size: 0.8rem;">T9</div>
                </div>
                <div class="text-center">
                    <div style="height: 130px; width: 18px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 98%; width: 100%; background: var(--accent-purple); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-purple); font-weight: 600; font-size: 0.85rem;">142h</div>
                    <div class="text-secondary" style="font-size: 0.8rem;">T10</div>
                </div>
                <div class="text-center">
                    <div style="height: 130px; width: 18px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 60%; width: 100%; background: #d0c4ff; border-radius: 6px;"></div>
                    </div>
                    <div style="color: #d0c4ff; font-weight: 600; font-size: 0.85rem;">87h</div>
