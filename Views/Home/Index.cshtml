@{
    ViewData["Title"] = "Tổng quan";
    int totalEmp = ViewBag.TotalEmployees ?? 12;
    int totalPresent = ViewBag.TotalPresent ?? 9;
    int lateOrAbsent = ViewBag.LateOrAbsent ?? 3;
    int pendingTotal = ViewBag.PendingTotal ?? 5;
    int pendingLeaves = ViewBag.PendingLeaves ?? 3;
    int pendingSwaps = ViewBag.PendingSwaps ?? 2;
    double presentPercent = totalEmp > 0 ? Math.Round((double)totalPresent / totalEmp * 100, 1) : 85.0;
}

<div class="row mb-4">
    <div class="col-md-3">
        <div class="stat-card card-dark">
            <h6 class="stat-card-title">TỔNG NHÂN VIÊN</h6>
            <div class="stat-card-value">@totalEmp</div>
            <div class="stat-card-desc">Đang hoạt động tại 5 phòng ban</div>
            <div class="stat-icon purple">
                <i class="fa-solid fa-users"></i>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="stat-card card-dark">
            <h6 class="stat-card-title">ĐÃ CHẤM CÔNG</h6>
            <div class="stat-card-value green">@totalPresent</div>
            <div class="stat-card-desc">@presentPercent% tỷ lệ ghi nhận</div>
            <div class="stat-icon green">
                <i class="fa-solid fa-user-check"></i>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="stat-card card-dark">
            <h6 class="stat-card-title">ĐI TRỄ / VẮNG</h6>
            <div class="stat-card-value orange">@lateOrAbsent</div>
            <div class="stat-card-desc">Cần theo dõi nhắc nhở</div>
            <div class="stat-icon orange">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="stat-card card-dark">
            <h6 class="stat-card-title">ĐƠN CHỜ DUYỆT</h6>
            <div class="stat-card-value red">@pendingTotal</div>
            <div class="stat-card-desc">@pendingSwaps đổi ca &bull; @pendingLeaves xin nghỉ</div>
            <div class="stat-icon red">
                <i class="fa-solid fa-file-circle-question"></i>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Chart Area -->
    <div class="col-md-8">
        <div class="card-dark h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="mb-1">Tỷ lệ chuyên cần</h5>
                    <p class="text-secondary" style="font-size: 0.85rem; margin: 0;">Thống kê 7 ngày trong tuần (@DateTime.Now.ToString("MM/yyyy"))</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Attendance" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3" style="border-color: var(--border-color); color: var(--text-secondary);">Xem chấm công</a>
                </div>
            </div>
            
            <div style="height: 250px; display: flex; align-items: flex-end; justify-content: space-around; padding-bottom: 30px; border-bottom: 1px solid var(--border-color);">
                <div class="text-center">
                    <div style="height: 140px; width: 14px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 94%; width: 100%; background: var(--accent-purple); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-purple); font-weight: 600; font-size: 0.8rem;">94%</div>
                    <div style="color: var(--text-secondary); font-size: 0.75rem;">T2</div>
                </div>
                
                <div class="text-center">
                    <div style="height: 140px; width: 14px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 88%; width: 100%; background: var(--accent-purple); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-purple); font-weight: 600; font-size: 0.8rem;">88%</div>
                    <div style="color: var(--text-secondary); font-size: 0.75rem;">T3</div>
                </div>
                
                <div class="text-center">
                    <div style="height: 140px; width: 14px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 96%; width: 100%; background: var(--accent-green); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-green); font-weight: 600; font-size: 0.8rem;">96%</div>
                    <div style="color: var(--text-secondary); font-size: 0.75rem;">T4</div>
                </div>
                
                <div class="text-center">
                    <div style="height: 140px; width: 14px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 91%; width: 100%; background: var(--accent-purple); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-purple); font-weight: 600; font-size: 0.8rem;">91%</div>
                    <div style="color: var(--text-secondary); font-size: 0.75rem;">T5</div>
                </div>
                
                <div class="text-center">
                    <div style="height: 140px; width: 14px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 98%; width: 100%; background: var(--accent-green); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-green); font-weight: 600; font-size: 0.8rem;">98%</div>
                    <div style="color: var(--text-secondary); font-size: 0.75rem;">T6</div>
                </div>
                
                <div class="text-center">
                    <div style="height: 140px; width: 14px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 85%; width: 100%; background: var(--accent-orange); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-orange); font-weight: 600; font-size: 0.8rem;">85%</div>
                    <div style="color: var(--text-secondary); font-size: 0.75rem;">T7</div>
                </div>
                
                <div class="text-center">
                    <div style="height: 140px; width: 14px; background: var(--border-color); border-radius: 6px; margin: 0 auto 10px; display: flex; align-items: flex-end;">
                        <div style="height: 82%; width: 100%; background: var(--accent-orange); border-radius: 6px;"></div>
                    </div>
                    <div style="color: var(--accent-orange); font-weight: 600; font-size: 0.8rem;">82%</div>
                    <div style="color: var(--text-secondary); font-size: 0.75rem;">CN</div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-2">
                <div class="d-flex gap-4">
                    <span class="text-secondary" style="font-size: 0.8rem;"><i class="fa-solid fa-circle me-1" style="color: var(--accent-green); font-size: 0.5rem;"></i> Đạt chuẩn (&ge;95%)</span>
                    <span class="text-secondary" style="font-size: 0.8rem;"><i class="fa-solid fa-circle me-1" style="color: var(--accent-purple); font-size: 0.5rem;"></i> Ổn định (88-94%)</span>
                    <span class="text-secondary" style="font-size: 0.8rem;"><i class="fa-solid fa-circle me-1" style="color: var(--accent-orange); font-size: 0.5rem;"></i> Cuối tuần (&lt;88%)</span>
                </div>
                <a asp-controller="Schedule" asp-action="Index" class="text-decoration-none" style="color: var(--accent-purple); font-size: 0.85rem;">Xem lịch phân ca &rarr;</a>
            </div>
        </div>
    </div>
    
    <!-- Sidebar List -->
    <div class="col-md-4">
        <div class="card-dark h-100">
            <h5 class="mb-4">Ca làm việc trong ngày</h5>
            
            <div class="mb-4">
                <div class="d-flex justify-content-between mb-2">
                    <span style="font-size: 0.85rem;">Ca Sáng (08:00 - 14:00)</span>
                    <span style="font-size: 0.85rem;"><span class="text-warning fw-bold">3</span><span class="text-secondary">/3 NV</span></span>
                </div>
                <div class="progress" style="height: 6px; background-color: var(--border-color);">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: 100%;"></div>
                </div>
            </div>
            
            <div class="mb-4">
                <div class="d-flex justify-content-between mb-2">
                    <span style="font-size: 0.85rem;">Ca Chiều (14:00 - 20:00)</span>
                    <span style="font-size: 0.85rem;"><span class="text-success fw-bold">3</span><span class="text-secondary">/3 NV</span></span>
                </div>
                <div class="progress" style="height: 6px; background-color: var(--border-color);">
                    <div class="progress-bar bg-success" role="progressbar" style="width: 100%; background-color: var(--accent-green) !important;"></div>
                </div>
            </div>
            
            <div class="mb-4">
                <div class="d-flex justify-content-between mb-2">
                    <span style="font-size: 0.85rem;">Ca Tối (18:00 - 23:59)</span>
                    <span style="font-size: 0.85rem;"><span style="color: var(--accent-purple); font-weight: bold;">4</span><span class="text-secondary">/4 NV</span></span>
                </div>
                <div class="progress" style="height: 6px; background-color: var(--border-color);">
                    <div class="progress-bar" role="progressbar" style="width: 100%; background-color: var(--accent-purple);"></div>
                </div>
            </div>
            
            <hr style="border-color: var(--border-color); margin: 24px 0;">
            
            <h6 class="text-secondary mb-3" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">NHÂN SỰ THEO PHÒNG BAN</h6>
            
            @if (ViewBag.DeptStats != null)
            {
                foreach (var dept in ViewBag.DeptStats)
                {
                    <div class="d-flex justify-content-between mb-2 pb-1 align-items-center">
                        <span style="font-size: 0.9rem;">@dept.TenPhongBan</span>
                        <span class="badge rounded-pill" style="background: rgba(146,119,248,0.15); color: #d0c4ff;">@dept.SoLuong NV</span>
                    </div>
                }
            }
        </div>
    </div>
</div>
